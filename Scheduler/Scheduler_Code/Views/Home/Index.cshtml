@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Busy Work Scheduler</h1>
    <p>Scheduling Made Easy</p>
</div>
<!--Div for informational substances -->
<div>
    <p>Enter the days and times everyone is busy</p>
    <p>Using this Format: (<span style="color: red;">M15 T09 SU14 SA11 F08</span>)</p>
    <p>Where Sunday and Saturday are abbrevieated as SU, M, T, W, R, F, SA and tiems go from 8 to 16</p>
</div>
<!-- For inputting the information into the table-->
<div>
    <p> Busy times</p>
    <form asp-action="FillSchedule" method="post">
        <div class="form-group">
            <label for="Home" class="form-label">Example Textarea</label>
            <textarea class="form-control" id="Home" rows="3"></textarea>
        </div>
    </form>
</div>

<!-- Add a break here so it looiks a lil nicer-->
<br />
<br />

<div>
    <table class="table">
        <thead class="thead-dark">
            <tr>
                <th scope="col">Time</th>
                <th scope="col">Sunday</th>
                <th scope="col">Monday</th>
                <th scope="col">Tuesday</th>
                <th scope=col">Wednesday</th>
                <th scope=col">Thursday</th>
                <th scope=col">Friday</th>
                <th scope=col">Saturday</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <th scope="row">8:00</th>
            </tr>
            <tr>
                <th scope="row">9:00</th>
            </tr>
            <tr>
                <th scope="row">10:00</th>
            </tr>
            <tr>
                <th scope="row">11:00</th>
            </tr>
            <tr>
                <th scope="row">12:00</th>
            </tr>
            <tr>
                <th scope="row">13:00</th>
            </tr>
            <tr>
                <th scope="row">14:00</th>
            </tr>
            <tr>
                <th scope="row">15:00</th>
            </tr>
            <tr>
                <th scope="row">16:00</th>
            </tr>
        </tbody>
    </table>
</div>

<br />

<div>
    <!--Have to add inluce weekends :|-->
    <input type="checkbox" />
    <label>Include Weekends</label>
</div>


<button class="btn btn-primary" type="submit">Submit</button>
