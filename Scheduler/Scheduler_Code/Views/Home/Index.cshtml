@model Scheduler_Code.Models.ScheduleViewModel
@{
    ViewData["Title"] = "Busy Work Scheduler";

    var dayNames = new Dictionary<string, string>
    {
        ["SU"] = "Sunday",
        ["M"] = "Monday",
        ["T"] = "Tuesday",
        ["W"] = "Wednesday",
        ["R"] = "Thursday",
        ["F"] = "Friday",
        ["SA"] = "Saturday"
    };
}

<div class="text-center">
    <h1 class="display-4">Busy Work Scheduler</h1>
    <p>Scheduling Made Easy</p>
</div>
<!--Div for informational substances -->
<div>
    <p>Enter the days and times everyone is busy</p>
    <p>Using this Format: (<code>M8 T12 W9 R10 R14</code>)</p>
    <p>Where Sunday and Saturday are abbrevieated as SU, M, T, W, R, F, SA and tiems go from 8 to 16</p>
    <p>You can separate entries with a space, commas, dashes, semi-colons, and colons.</p>
</div>
<!-- For inputting the information into the table-->
<form asp-action="Index" method="post">
    <div class="form-group">
        <label asp-for="BusyTimes" class="form-label">Busy Times</label>
        <textarea asp-for="BusyTimes" class="form-control" rows="3"></textarea>
    </div>


    <!-- Add a break here so it looiks a lil nicer-->
    <br />
    <br />

    <div>
        <table class="table table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th scope="col">Time</th>
                    @foreach (var day in Model.Days)
                    {
                        <th scope="col">@dayNames[day]</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var hour in Model.Hours)
                {
                    <tr>
                        <th scope="row">@($"{hour}:00")</th>
                        @foreach (var day in Model.Days)
                        {
                            if (Model.HasResults && Model.FreeTimes.Contains((day, hour)))
                            {
                                <td class="table-success">Free</td>
                            }
                            else
                            {
                                <td></td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <br />

    <div class="form-check mb-3">
        <input asp-for="IncludeWeekends" class="form-check-input" />
        <label asp-for="IncludeWeekends" class="form-check-label">Include Weekends</label>
    </div>


    <button class="btn btn-primary" type="submit">Submit</button>
</form>